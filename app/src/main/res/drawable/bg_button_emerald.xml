<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="90" android:startColor="@color/emerald_800" android:endColor="@color/emerald_900"/>
            <corners android:radius="@dimen/radius_md"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#9CC7B6"/>
            <corners android:radius="@dimen/radius_md"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="90" android:startColor="@color/emerald_500" android:endColor="@color/emerald_700"/>
            <corners android:radius="@dimen/radius_md"/>
        </shape>
    </item>
</selector>
