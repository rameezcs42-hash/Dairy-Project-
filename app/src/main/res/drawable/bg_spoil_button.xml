<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#33FFFFFF"/><stroke android:width="1dp" android:color="#FFFFFF"/><corners android:radius="@dimen/radius_md"/></shape>
