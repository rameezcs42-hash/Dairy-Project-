<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header_gradient"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="38dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Monthly Billing"
                android:textColor="#FFFFFF"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:textSize="21sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/billing_prev_month"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#1AFFFFFF"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="‹" android:textColor="#FFFFFF" android:textSize="26sp"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/billing_month"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="November 2026"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="17sp" />

                <FrameLayout
                    android:id="@+id/billing_next_month"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#1AFFFFFF"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="›" android:textColor="#FFFFFF" android:textSize="26sp"/>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btn_generate_all"
                    style="@style/Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="42dp"
                    android:layout_marginEnd="5dp"
                    android:text="Generate ALL PDFs"
                    android:textSize="12.5sp"
                    android:textColor="#FBBF24"
                    android:background="@drawable/bg_spoil_button" />
                <Button
                    android:id="@+id/btn_summary_pdf"
                    style="@style/Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="42dp"
                    android:layout_marginStart="5dp"
                    android:text="Summary PDF"
                    android:textSize="12.5sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_spoil_button" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/billing_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@color/surface_low"
            android:text="0 customers • 0 L • Rs 0 billed"
            android:textColor="@color/ink_secondary"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/billing_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@color/divider"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/billing_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="40dp"
            android:text="No deliveries recorded for this month yet."
            android:textColor="@color/ink_hint"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
