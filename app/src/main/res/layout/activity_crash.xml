<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="#2B0A0A">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DairyFlow crashed"
        android:textColor="#FF8A80"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/crash_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#FFCDD2"
        android:textSize="13sp"
        android:text="version" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Tablet/phone pe yeh error dikha — screenshot lekar developer ko bhej dein. Neeche pura crash log hai (scroll karein):"
        android:textColor="#FFCDD2"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:background="#1A0505"
        android:padding="10dp">
        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/crash_trace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="#E7EDF3" />
        </ScrollView>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <Button
            android:id="@+id/crash_copy"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Copy error"
            android:textSize="12sp" />

        <Button
            android:id="@+id/crash_continue"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Open app anyway"
            android:textSize="12sp" />

        <Button
            android:id="@+id/crash_close"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Close app"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
