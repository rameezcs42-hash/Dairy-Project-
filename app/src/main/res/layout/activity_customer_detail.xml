<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header_gradient"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="38dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_avatar">
                    <TextView
                        android:id="@+id/detail_avatar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="AB"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="21sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:id="@+id/detail_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Customer"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="20sp" />
                    <TextView
                        android:id="@+id/detail_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Area • phone"
                        android:textColor="#A7F3D0"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/detail_tags"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Buffalo • Rs 130/L • Off: Sunday"
                        android:textColor="#D1FAE5"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/edit_customer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EDIT"
                    android:textColor="#FBBF24"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:letterSpacing="0.12"
                    android:padding="10dp"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <!-- Balance panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1AFFFFFF"
                    android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BALANCE" android:textColor="#FBBF24" android:textSize="9.5sp" android:letterSpacing="0.2" android:textStyle="bold"/>
                    <TextView android:id="@+id/detail_balance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rs 0" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
                    <TextView android:id="@+id/detail_balance_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DUE" android:textColor="#A7F3D0" android:textSize="10sp" android:layout_marginTop="1dp"/>
                </LinearLayout>

                <View android:layout_width="10dp" android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1AFFFFFF"
                    android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="THIS MONTH" android:textColor="#FBBF24" android:textSize="9.5sp" android:letterSpacing="0.2" android:textStyle="bold"/>
                    <TextView android:id="@+id/detail_month_litres" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 L" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
                    <TextView android:id="@+id/detail_month_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rs 0" android:textColor="#A7F3D0" android:textSize="10.5sp" android:layout_marginTop="1dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Action row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="12dp"
            android:background="@color/surface"
            android:elevation="3dp">

            <TextView android:id="@+id/action_call" style="@style/ActionPill" android:layout_width="0dp" android:layout_weight="1" android:text="Call" />
            <TextView android:id="@+id/action_whatsapp" style="@style/ActionPill" android:layout_width="0dp" android:layout_weight="1" android:text="SMS" />
            <TextView android:id="@+id/action_pay" style="@style/ActionPill" android:layout_width="0dp" android:layout_weight="1" android:text="Payment" />
            <TextView android:id="@+id/action_invoice" style="@style/ActionPill" android:layout_width="0dp" android:layout_weight="1" android:text="Invoice" />
        </LinearLayout>

        <!-- Ledger -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LEDGER (DELIVERIES &amp; PAYMENTS)"
                android:textAppearance="@style/TextAppearance.Label"
                android:layout_marginBottom="6dp" />

            <ListView
                android:id="@+id/ledger_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:divider="@color/divider"
                android:dividerHeight="1dp" />

            <TextView
                android:id="@+id/ledger_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="No deliveries or payments yet for this customer."
                android:textColor="@color/ink_hint"
                android:visibility="gone" />
        </LinearLayout>

        <View android:layout_height="20dp" />
    </LinearLayout>
</ScrollView>
