<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header_gradient"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="38dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/report_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Report"
                android:textColor="#FFFFFF"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/report_prev"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#1AFFFFFF"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="‹" android:textColor="#FFFFFF" android:textSize="24sp"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/report_period"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="Period"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <FrameLayout
                    android:id="@+id/report_next"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#1AFFFFFF"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="›" android:textColor="#FFFFFF" android:textSize="24sp"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Summary stat strip -->
        <LinearLayout
            android:id="@+id/report_summary_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:background="@color/surface_low">

            <TextView
                android:id="@+id/report_summary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/ink_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ListView
            android:id="@+id/report_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@color/divider"
            android:dividerHeight="1dp" />

        <!-- Export bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bottom_nav_bg"
            android:elevation="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <Button
                android:id="@+id/report_export"
                style="@style/Button.Emerald"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:text="Export PDF" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
