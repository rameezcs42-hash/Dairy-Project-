<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="6dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@color/surface">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_avatar">
        <TextView
            android:id="@+id/row_bill_avatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="AB"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/row_bill_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customer"
            android:textColor="@color/ink"
            android:textStyle="bold"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/row_bill_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="30 L • Rs 3,600 • paid Rs 2,000"
            android:textColor="@color/ink_hint"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/row_bill_balance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rs 1,600 due"
            android:textColor="@color/danger_600"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/row_bill_pdf"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_button_outlined"
        android:clickable="true"
        android:foreground="?android:attr/selectableItemBackground">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="PDF"
            android:textColor="@color/emerald_800"
            android:textStyle="bold"
            android:textSize="11sp" />
    </FrameLayout>
</LinearLayout>
