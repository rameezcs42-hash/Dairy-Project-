<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <View
        android:id="@+id/ledger_dot"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:background="@drawable/bg_dot_emerald" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/ledger_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Morning delivery — 2.0 L"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/ledger_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="01 Nov • rate Rs 130"
            android:textColor="@color/ink_hint"
            android:textSize="10.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ledger_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+ Rs 260"
        android:textColor="@color/danger_600"
        android:textStyle="bold"
        android:textSize="13.5sp" />
</LinearLayout>
