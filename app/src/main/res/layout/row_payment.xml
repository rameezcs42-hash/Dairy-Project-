<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@color/surface">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_method_circle">

        <TextView
            android:id="@+id/row_method"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="₨"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/row_pay_customer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customer"
            android:textColor="@color/ink"
            android:textStyle="bold"
            android:textSize="14.5sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/row_pay_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="date • cash"
            android:textColor="@color/ink_hint"
            android:textSize="11.5sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_pay_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rs 0"
        android:textColor="@color/emerald_800"
        android:textStyle="bold"
        android:textSize="14.5sp" />
</LinearLayout>
