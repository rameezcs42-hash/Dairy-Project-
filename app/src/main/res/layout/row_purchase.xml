<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1.2"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_purchase_supplier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Supplier"
            android:textColor="@color/ink"
            android:textStyle="bold"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/row_purchase_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="01 Nov • buffalo • Rs 95/L"
            android:textColor="@color/ink_hint"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/row_purchase_litres"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+100 L"
            android:textColor="@color/emerald_800"
            android:textStyle="bold"
            android:textSize="14.5sp" />

        <TextView
            android:id="@+id/row_purchase_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rs 9,500"
            android:textColor="@color/ink_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
