<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DairyFlow" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/emerald_700</item>
        <item name="android:colorPrimaryDark">@color/emerald_900</item>
        <item name="android:colorAccent">@color/emerald_500</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/emerald_900</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:colorEdgeEffect">@color/emerald_500</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:spinnerItemStyle">@style/SpinnerItem</item>
        <item name="android:textCursorDrawable">@drawable/cursor_emerald</item>
    </style>

    <style name="Theme.DairyFlow.Splash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/emerald_900</item>
        <item name="android:navigationBarColor">@color/emerald_900</item>
    </style>

    <style name="SpinnerItem" parent="android:Widget.Material.TextView.SpinnerItem">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">4dp</item>
    </style>

    <style name="TextAppearance.Display" parent="android:TextAppearance.Material.Display1">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.Title" parent="android:TextAppearance.Material.Title">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">19sp</item>
    </style>
    <style name="TextAppearance.Subtitle" parent="android:TextAppearance.Material.Subhead">
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.Label" parent="android:TextAppearance">
        <item name="android:textColor">@color/ink_hint</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Button.Emerald" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_emerald</item>
        <item name="android:textColor">@color/on_emerald</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="Button.Outlined" parent="android:Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_button_outlined</item>
        <item name="android:textColor">@color/emerald_800</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="InputField" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_hint</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="android:minHeight">50dp</item>
    </style>
</resources>
